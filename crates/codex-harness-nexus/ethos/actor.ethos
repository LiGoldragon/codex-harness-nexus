                                    ConfigurationChange AwaitedDirectories
                                    ConfigurationRefusal Set SessionsDirectories
                                    UnwatchableDirectory ]
  signal_codex_harness_nexus:Diagnostic ]
[ WatchGeneration.Integer
  WatchChangeKind.[ CreatedFolder Created Removed RenamedFrom Modified Other ]
  WatchEvent.{ WatchChangeKind Vector<FilePath> }
  WatchFailure.{ Option<FilePath> Diagnostic }
  WatchResult.[ WatchEvent WatchFailure ]
  WatchWord.{ WatchGeneration WatchResult }
  Reach.[ Entries Whole ]
  Placement.{ FilePath Option<FilePath> }
  WatchConsequence.[ Written.Vector<FilePath> Arrived.Vector<FilePath> WatchFailure ]
  ListenerFailure.[ Meta.String Public.String ]
  Opened.Boolean
  ReadConfigurationRequest.{}
  ConfigureRequest.{ Set }
  WatchSessionsRequest.{ SessionsDirectories }
  FollowWatchRequest.{ WatchWord }
  OpenPublicRequest.{}
  PerformRequest.{ Operation }
  ReportRequest.{ Hook }
  SubscribeObservationsRequest.{}
  SubscribeConfigurationRequest.{}
  ActorFailure.{ Diagnostic } ]
[ ConfigurationSetting.[ setting.[ Set ] ]
  SessionsDirectoriesSetting.[ sessions_directories.[ SessionsDirectories ] ]
  PlacementPositioning.[ placed.[ Placement ] ]
  PlacementState.[ arrived.[ Boolean ] reach.[ Reach ] ]
  ReachCoverage.[ reaches.{ [ Reach ] [ Boolean ] } ]
  Settling.[ settle!{ [] [ Vector<UnwatchableDirectory> ] }
              forget!{ [ WatchEvent ] [] }
              written.{ [ WatchEvent ] [ Vector<FilePath> ] }
              awaited.[ AwaitedDirectories ] ]
  PublicOpening.[ open_public.[ Result<Opened ListenerFailure> ] ]
  WatchWordInput.[ watch_word.[ WatchWord ] ]
  Reportable.[ hook.[ Hook ] ]
  ConfigurationReading.[ readout.[ Result<ConfigurationReadout Diagnostic> ] ]
  NexusPort.[ read_configuration.[ Result<ConfigurationReadout Diagnostic> ]
              configure.{ [ ConfigurationSetting ]
                          [ Result<Configuration ConfigurationRefusal> ] }
              watch_sessions.{ [ SessionsDirectoriesSetting ] [ Option<WatchFailure> ] }
              follow_watch.{ [ WatchWordInput ] [ Vector<WatchConsequence> ] }
              open_public.[ Result<Opened ListenerFailure> ]
              perform.{ [ Operable ] [ Result<Performed ReportFailure> ] }
              report.{ [ Reportable ] [ Result<Performed ReportFailure> ] }
              subscribe_observations.[ Result<Stream<Observations Changed> ReportFailure> ]
              subscribe_configuration.[ Result<Stream<ConfigurationReadout ConfigurationChange>
                                              ConfigurationRefusal> ] ]
  NexusRuntime.[ read_configuration.[ Result<ConfigurationReadout Diagnostic> ]
                  configure!{ [ ConfigurationSetting ]
                              [ Result<Configuration ConfigurationRefusal> ] }
                  watch_sessions!{ [ SessionsDirectoriesSetting ]
                                   [ Option<WatchFailure> ] }
                  follow_watch!{ [ WatchWord ] [ Vector<WatchConsequence> ] }
                  open_public!{ [] [ Result<Opened ListenerFailure> ] } ] ]
